<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mac-native деплой asr-adaptor, ИСТОРИЧЕСКАЯ раскладка (код и venv в ~/diar-test).
     Аудио — loopback к локальным Mac-сервисам. `/Users/USER` и REPLACE_WITH_* подставить своими.

     ⚠️ Для новой машины этот файл не нужен: `deploy/mac/install.sh --launchd` генерирует плист сам,
     с путями этой машины, и держит секреты в ~/.asr-stack.env (0600), а не в плисте — тот лежит
     в ~/Library/LaunchAgents и читается кем угодно. Образец оставлен для уже развёрнутых
     инстансов. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.podlodka.asr</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/USER/diar-test/.venv-asr/bin/uvicorn</string>
        <string>app:app</string>
        <string>--host</string>
        <string>0.0.0.0</string>
        <string>--port</string>
        <string>8082</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/USER/diar-test/asr-adaptor</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>OR_KEY</key>
        <string>REPLACE_WITH_OPENROUTER_KEY</string>
        <key>ASR_DIARIZER_URL</key>
        <string>http://127.0.0.1:8090/diarize</string>
        <key>ASR_BACKEND_URL</key>
        <string>http://127.0.0.1:8123/v1/audio/transcriptions</string>
        <key>ASR_CAMPP_URL</key>
        <string>http://127.0.0.1:8126/embed-centroids</string>
        <key>ASR_REGISTRY_PATH</key>
        <string>/Users/USER/diar-test/speaker_registry.json</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/USER/llm-stack/logs/asr-launchd.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/USER/llm-stack/logs/asr-launchd.log</string>
</dict>
</plist>
