# Окружение Mac-стека транскрибации. Копируется установщиком в ~/.asr-stack.env и правится руками:
# СЕКРЕТЫ ЖИВУТ ТОЛЬКО ТАМ, в git этот файл идёт без значений.
#
#   cp env.example ~/.asr-stack.env && chmod 600 ~/.asr-stack.env
#
# Файл читают install.sh, stack.sh и генерируемые плисты.

# --- где живёт стек (модели, venv-ы, состояние, логи) ---
ASR_STACK_HOME="$HOME/asr-stack"

# --- чекаут morag: код адаптера и бэкендов берётся ОТСЮДА, не копируется ---
MORAG_REPO="$HOME/PycharmProjects/open-source/morag"

# --- LLM для стадий глоссария/правки/наминга ---
# Имя OR_KEY историческое (держало ключ xAI); сейчас в бою OpenRouter.
OR_KEY=
ASR_LLM_BASE_URL=https://openrouter.ai/api/v1
ASR_LLM_MODEL=deepseek/deepseek-v4-flash
ASR_LLM_ENABLE_THINKING=false
ASR_LLM_MAX_CONCURRENT=8

# --- egress-прокси: OpenRouter не пускает RU-IP ---
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1

# --- Bearer'ы локальных бэкендов ---
# ЗАПОЛНЯТЬ НЕ НАДО: install.sh сгенерирует и допишет сюда. Это секрет между процессами одной
# машины (диаризатор без своего ключа вообще не стартует).
# Каждый ключ дублируется под именем, которое ждёт сам бэкенд.
ASR_BACKEND_KEY=
ASR_CAMPP_KEY=
ASR_DIARIZER_KEY=
TRANSCRIBE_API_KEY=
CAMPP_API_KEY=
DIARIZER_API_KEY=

# --- HF-токен: нужен ТОЛЬКО для gated-части pyannote (segmentation-3.0 и speaker-diarization-3.1).
# Всё остальное качается свободно: whisper (chukanov/whisper-podlodka-turbo-mlx), CAM++ (релизы
# sherpa-onnx) и эмбеддер голосов pyannote/wespeaker-voxceleb-resnet34-LM.
# Завести: huggingface.co/settings/tokens (роль read достаточно), а условия принять на страницах
# huggingface.co/pyannote/segmentation-3.0 и huggingface.co/pyannote/speaker-diarization-3.1. ---
HF_TOKEN=

# --- ПРОФИЛЬ КОРПУСА: всё, что отличает одну папку записей от другой ---
# Конвейер generic и жанр записи знать не обязан; доменное — здесь. Для второго корпуса заведите
# второй файл и запускайте с ASR_STACK_ENV=~/.asr-stack-<корпус>.env (см. README, «Профили»).

# Что это за материал. Одна строка в РОДИТЕЛЬНОМ падеже — она встаёт в промпты правки терминов
# («расшифровку фрагмента …») и наминга («Тебе дано НАЧАЛО …»), поэтому единственное число удобнее:
#   ASR_CORPUS_DESC="рабочей записи: встречи, митапа или обучающего материала по разработке"
# Пусто → дефолт прежний (подкаст про технологии).
ASR_CORPUS_DESC=""

# Постоянные термины корпуса: имена участников и повторяющиеся продукты идут в подсказку ASR
# ВСЕГДА — глоссарий переоткрывает термины на каждой записи и на устойчивом гарбле срывается.
# ⚠️ В КАВЫЧКАХ: файл читается через `source`, и пробел в значении иначе разорвёт строку.
ASR_ALWAYS_TERMS=""

# Сколько голосов ждать. Дефолт 1-10; на совещании с десятком участников потолок поднять.
ASR_MIN_SPEAKERS=1
ASR_MAX_SPEAKERS=10

# Свой реестр голосов на корпус. ⚠️ ОБЯЗАТЕЛЬНО для второго корпуса: реестр общий — значит голоса
# коллег попадут в одно пространство Speaker_N с голосами из подкаста, а ложный voice-матч (порог
# 0.55) подпишет человека чужим именем.
# ASR_REGISTRY_PATH="$HOME/asr-stack/state/speaker_registry-work.json"

# Наминг ищет представления в первых репликах («меня зовут…», «сегодня с нами…»). Если на ваших
# записях так не представляются — можно выключить и не тратить два вызова LLM: людей всё равно
# опознает реестр голосов, когда вы один раз проставите им имена.
# ASR_ENABLE_NAMING=0

# --- параллелизм. На 16 ГБ держать по единице: whisper один держит ~10-12 ГБ ---
ASR_MAX_JOBS=1
ASR_DIARIZE_SLOTS=1
ASR_WHISPER_SLOTS=1
ASR_CAMPP_SLOTS=1
ASR_ALIGN_SLOTS=1

# --- устройство: пусто → mps|cuda|cpu автоматом ---
DIARIZER_DEVICE=auto
ASR_ALIGN_DEVICE=
