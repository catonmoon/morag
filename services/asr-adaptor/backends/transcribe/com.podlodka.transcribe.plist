<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.podlodka.transcribe</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/USER/diar-test/.venv-whisper/bin/uvicorn</string>
        <string>app:app</string>
        <string>--host</string>
        <string>0.0.0.0</string>
        <string>--port</string>
        <string>8123</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/USER/diar-test/transcribe_backend</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>TRANSCRIBE_API_KEY</key>
        <string>REPLACE_WITH_ASR_KEY</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/USER/llm-stack/logs/transcribe-launchd.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/USER/llm-stack/logs/transcribe-launchd.log</string>
</dict>
</plist>
