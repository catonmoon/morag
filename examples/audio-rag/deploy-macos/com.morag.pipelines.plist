<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- morag RAG: OWUI Pipelines (github.com/open-webui/pipelines, нативно) + morag_pipeline.py.
     Конфиг conf/config.yml (retrieval + OpenRouter-ключ). HTTPS_PROXY - для OpenRouter
     (агент qwen36 / реранкер / dense query-эмбеддер qwen3-embedding); NO_PROXY - локальные
     qdrant:6333 и gte:8081. Обновление кода: scp morag_pipeline.py + src/ -> pip install
     ~/morag-rag/morag/ -> kill uvicorn (KeepAlive поднимет). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.morag.pipelines</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/USERNAME/morag-rag/pipelines/.venv-pipelines/bin/uvicorn</string>
        <string>main:app</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>9099</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/USERNAME/morag-rag/pipelines</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PIPELINES_DIR</key>
        <string>/Users/USERNAME/morag-rag/pipelines/pipelines</string>
        <key>MORAG_CONFIG_PATH</key>
        <string>/Users/USERNAME/morag-rag/conf/config.yml</string>
        <key>PIPELINE_NAME</key>
        <string>morag-audio</string>
        <key>TIKTOKEN_CACHE_DIR</key>
        <string>/Users/USERNAME/morag-rag/pipelines/tiktoken_cache</string>
        <key>NLTK_DATA</key>
        <string>/Users/USERNAME/morag-rag/pipelines/nltk_data</string>
        <key>HTTPS_PROXY</key>
        <string>http://user:pass@your-proxy:port</string>
        <key>NO_PROXY</key>
        <string>localhost,127.0.0.1</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/USERNAME/logs/morag-pipelines-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/USERNAME/logs/morag-pipelines-launchd.log</string>
</dict>
</plist>
