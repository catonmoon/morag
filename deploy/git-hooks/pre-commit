#!/bin/sh
# Сторож перед коммитом. Репозиторий корпуса, лежащий рядом, знает, какие слова — данные компании
# (имена, гарблы, внутренние системы, маркеры); здесь такого списка нет и быть не может — он сам
# был бы утечкой. Хук ищет соседей с инструментом `tools/leak_check.py` и просит каждого проверить
# ИНДЕКС этого чекаута — ровно то, что уйдёт в коммит, а не рабочее дерево: незастейдженный
# черновик коммиту не мешает. Ненулевой код — коммит не создаётся. Соседа нет — хук молчит.
#
# Включить один раз в клоне: git config core.hooksPath deploy/git-hooks
# Обойти осознанно:          git commit --no-verify   (и ответить себе, почему)
set -e
here=$(cd "$(dirname "$0")/../.." && pwd)
found=0
for guard in "$here"/../*/tools/leak_check.py; do
  [ -f "$guard" ] || continue
  repo=$(cd "$(dirname "$guard")/.." && pwd)      # нормализованный путь: иначе «../» прячет соседа под нашим
  [ "$repo" = "$here" ] && continue
  found=1
  if ! python3 "$guard" --staged --root "$here"; then
    echo "pre-commit: сторож нашёл данные корпуса в индексе — коммит отменён" >&2
    exit 1
  fi
done
[ "$found" = 1 ] || echo "pre-commit: репозитория корпуса со сторожем рядом нет — проверка пропущена"
