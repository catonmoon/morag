# Project data: содержимое gitignored, .gitkeep сохраняет структуру папок
# чтобы они существовали после git clone (для bind-mount Docker).
data/*
!data/.gitkeep
volumes/*
!volumes/qdrant
!volumes/open-webui
volumes/qdrant/*
!volumes/qdrant/.gitkeep
volumes/open-webui/*
!volumes/open-webui/.gitkeep
old/

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Coverage
coverage_html/
.coverage

# Env
.env
# conf/ — каталог конфигов morag.
# conf/config.yml — baseline, в git.
# conf/config.local.yml — overlay (правки UI, секреты), gitignored.
# conf/state/ — runtime state indexer'а, gitignored (только .gitkeep).
conf/*
!conf/config.yml
!conf/state
conf/state/*
!conf/state/.gitkeep

# Старые artifacts корня (для тех кто ещё не перешёл на conf/).
config.yml
config.local.yml
config.*.yml

# Local docker-compose override (не для production)
docker-compose.override.yml

# Build-time data: NLTK ресурсы и HF tokenizer-кеш.
# Готовятся на машине с интернетом, COPY'ятся в образ при docker build.
# На air-gapped контуре привозятся отдельно (см. инструкции в CLAUDE.md / README).
nltk_data/
hf_cache/

# Reports — experiment logs
reports/

# Research artifacts с реальными provider URL'ами и логами прогонов
adventures/
experiments/

# Локальные research-runners с захардкоженными OWUI/xAI ключами
scripts/run_arena.py
scripts/run_dragon_native.py
scripts/run_dragon_questions.py
scripts/run_scorpi.py

# Claude Code internal instructions — never commit
CLAUDE.md

# macOS
.DS_Store
.idea/
